# Copie para .env.local e preencha. Nenhum valor real deve entrar neste arquivo —
# ele é versionado. Os nomes abaixo saíram de um levantamento do código
# (`process.env.*`), não de memória.

# ── Dados de satélite ────────────────────────────────────────────────────────
# Base do API Gateway que serve /fire e /lightning (repo satellite-fetcher-aws).
# Sem barra no final. Server-side apenas — NÃO prefixe com NEXT_PUBLIC_, senão a
# URL vai parar no bundle do navegador.
# Sem esta variável o site continua de pé, mas os dados de satélite são
# reportados como "fonte indisponível".
SATELLITE_API_URL=

# Chave do API Gateway, enviada como `x-api-key`. O backend não responde mais a
# quem não a apresenta — antes respondia a qualquer um, sem teto de gasto.
# Server-side apenas, pelo mesmo motivo da URL acima.
# Para obter o valor, com o AWS CLI autenticado na conta do projeto:
#   aws apigateway get-api-key --api-key <id> --include-value \
#     --query value --output text
# O <id> sai do output `ApiKeyId` do `cdk deploy`.
SATELLITE_API_KEY=

# ── APIs externas ────────────────────────────────────────────────────────────
# Geocoding reverso: converte a coordenada em nome de localidade.
OPEN_WEATHER_API_KEY=

# Mapa base. Usado no cliente, por isso o prefixo público — o token vai para o
# bundle e qualquer visitante consegue extraí-lo. É inevitável para um mapa que
# roda no navegador, e por isso a proteção é restringir o token por URL no
# account.mapbox.com, não escondê-lo.
#
# São necessários DOIS tokens, com valores diferentes por ambiente na Vercel.
# O motivo: o Mapbox não aceita curinga nas restrições de URL, e as URLs de
# preview da Vercel não são subdomínio da produção —
# `gaiasenses-web-git-<branch>-...vercel.app` é um rótulo único, irmão de
# `gaiasenses-web.vercel.app`. Cada branch gera um host novo, então uma lista de
# URLs fixas nunca acompanha.
#
#   Production : token restrito a `gaiasenses-web.vercel.app`
#                (mais o domínio próprio, quando existir)
#   Preview e Development : token separado, restrito no máximo a `vercel.app` e
#                `localhost`. Continua exposto nos previews, que são públicos —
#                o ganho é poder rotacioná-lo sem tocar na produção.
#
# ATENÇÃO — a conta atual não pertence ao projeto (agosto de 2026).
# Todo token do Mapbox é um JWT com o dono no payload; o que está em uso hoje
# decodifica para `{"u":"fmammoli"}`, ou seja, a conta pessoal do Felipe
# Mammoli, que NÃO faz mais parte do projeto. Ninguém do time consegue aplicar
# as restrições acima, rotacionar o token, ver a cota ou responder se a conta
# for encerrada — e o mapa cai junto. Criar conta nova no Mapbox exige cartão de
# crédito, então a decisão está com o time de pesquisa: cartão da pesquisa, ou
# troca por uma alternativa livre (ver docs/mapa-alternativas.md).
NEXT_PUBLIC_MAPBOX_API_ACCESS_TOKEN=

# ── Supabase (GaiaLogs, GaiaSubs) ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Ignora RLS. Só no servidor, nunca no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ── Notificações push ────────────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Protege /api/notifications: sem ele a rota fecha (fail-closed).
CRON_SECRET=

# ── Opcional ─────────────────────────────────────────────────────────────────
# WebSocket do Pd, se estiver usando um servidor próprio.
NEXT_PUBLIC_PD_WS_URL=

# NEXT_PUBLIC_VERCEL_ENV não vai aqui: a Vercel injeta sozinha.
