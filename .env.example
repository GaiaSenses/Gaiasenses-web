# Copie para .env.local e preencha. Nenhum valor real deve entrar neste arquivo —
# ele é versionado. Os nomes abaixo saíram de um levantamento do código
# (`process.env.*`), não de memória.

# ── Dados de satélite ────────────────────────────────────────────────────────
# Base do API Gateway que serve /fire e /lightning (repo satellite-fetcher-aws).
# Sem barra no final. Server-side apenas — NÃO prefixe com NEXT_PUBLIC_, senão a
# URL vai parar no bundle do navegador.
# Sem esta variável o site continua de pé, mas os dados de satélite são
# reportados como "fonte indisponível".
SATELLITE_API_URL=

# ── APIs externas ────────────────────────────────────────────────────────────
# Geocoding reverso: converte a coordenada em nome de localidade.
OPEN_WEATHER_API_KEY=

# Mapa base. Usado no cliente, por isso o prefixo público.
NEXT_PUBLIC_MAPBOX_API_ACCESS_TOKEN=

# ── Supabase (GaiaLogs, GaiaSubs) ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Ignora RLS. Só no servidor, nunca no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ── Notificações push ────────────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Protege /api/notifications: sem ele a rota fecha (fail-closed).
CRON_SECRET=

# ── Opcional ─────────────────────────────────────────────────────────────────
# WebSocket do Pd, se estiver usando um servidor próprio.
NEXT_PUBLIC_PD_WS_URL=

# NEXT_PUBLIC_VERCEL_ENV não vai aqui: a Vercel injeta sozinha.
