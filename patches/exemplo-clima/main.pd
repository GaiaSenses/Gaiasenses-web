#N canvas 100 100 620 480 12;
#X text 20 20 Exemplo do tutorial: a temperatura do lugar vira a altura de uma nota.;
#X text 20 45 Quanto mais quente \, mais agudo.;
#X obj 20 100 r gaia.temp;
#X obj 20 140 clip -10 45;
#X obj 20 180 * 8;
#X obj 20 220 + 220;
#X obj 20 300 osc~;
#X obj 20 340 *~ 0.05;
#X obj 20 380 dac~;
#X floatatom 140 260 8 0 0 0 - - - 0;
#X text 200 100 <- a temperatura chega aqui \, em graus Celsius;
#X text 200 260 <- frequencia em Hz;
#X connect 2 0 3 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 0 6 0;
#X connect 5 0 9 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 7 0 8 1;
