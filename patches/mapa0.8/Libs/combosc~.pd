#X text 374 -39 feedback do delay/oscilador;
#X text -731 318 Permite a entrada da frequência da fonte sonora se tiver ativado "pitch track" (pode ser ativado com "v", f 37;
#X obj 88 347 vline~;
#X obj 48 416 s~ freqvoz_\$0, f 10;
#X obj -468 318 r~ freqvoz_\$0, f 12;
#X text 85 202 recebe frequência da entrada \, que pode ser computada ou não \, dependendo da ativação do pitchtrack ("v"), f 45;
#X text -231 302 multiplica a frequência por um valor variável;
#X text 276 339 recebe frequência em sinal do 2º inlet~, f 21;
#X text -180 417 manda a frequência da voz após as multiplicações e alisamentos, f 32;
#X text 195 415 soma as frequência da voz e do inlet~ (transformadas em ms), f 61;
#X text 287 432 esses valores são enviados ao delay \, que recebe o sinal da voz e o mistura com suas cópias \, gerando um efeito de comb filtering, f 67;
#X text 124 526 o resultado disso é enviado ao "wet" da mix e de volta ao delay através de um feedback \, que com valores próximos a 1 gera uma espécie de dente de serra. Esse efeito \, somado à voz - ou a qualquer que for a entrada - resulta em um som complexo \, onde as bandas reforçadas pelo comb são evidenciadas de formas naturais e estranhas, f 69;
#X text -771 385 oscilador que recebe a frequência da voz \, e que manda o seu sinal ao "dry" \, reforçando a fundamental da voz (efeito opcional), f 43;
#X text 345 -197 manda frequência e amplitude da entrada;
#X text 439 -142 define um valor mínimo de amplitude para que sejam computados os dados. Se a amplitude for maior que o mínimo \, manda 1 para os envelopes de amplitude na mix \, se não \, manda 0 \, mutando. Para a inserção da voz como entrada é interessante que esse valor seja maior que a amplitude do ruído local, f 75;
#X text 824 101 mistura "dry" com "wet";
#X text 1066 280 recebe o booleano da amplitude mínima \, e define se o som será passado ou não;
#X text 1297 152 recebe o valor de mute \, para emergências...;
#X text 111 -642 se "v" \, ativar pitchtrack;
#X text 540 -640 se "m" \, mutar;
